# Copy this file to .env locally or add these values in Netlify Environment Variables.
# Never commit the real .env file.

# PUBLIC STORE SETTINGS
SITE_URL=https://wholesalegh.netlify.app
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_ME

# PAYSTACK SERVER SECRET
PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME

# FIREBASE WEB CONFIG (public values returned to the browser by /config)
FIREBASE_API_KEY=REPLACE_ME
FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
FIREBASE_PROJECT_ID=REPLACE_ME
FIREBASE_STORAGE_BUCKET=REPLACE_ME.appspot.com
FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
FIREBASE_APP_ID=REPLACE_ME

# FIREBASE ADMIN (server only)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-REPLACE_ME@REPLACE_ME.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# CLOUDINARY (server only when uploads are added to admin)
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# RESEND EMAIL (server only)
RESEND_API_KEY=re_REPLACE_ME
# During development, leave EMAIL_FROM unset to use Resend's sandbox sender.
# The sandbox sender can only deliver to the email address on your Resend account.
# EMAIL_FROM=The Wholesale Ghana <onboarding@resend.dev>
# After buying and verifying your domain, switch to for example:
# EMAIL_FROM=The Wholesale Ghana <orders@thewholesaleghana.com>

# STORE SETTINGS
DEFAULT_BATCH_CAPACITY=150
DELIVERY_MIN_DAYS=14
DELIVERY_MAX_DAYS=21
WHATSAPP_NUMBER=233533357961

# ADMIN ACCESS
ADMIN_EMAILS=owner@example.com,manager@example.com

# Cloudinary product image uploads (server-side signing)
